# Fujara environment
# Copy to .env.local. Never commit real secrets.
# The local import / playback / offline flow does not need any of these.

# --- Optional cloud metadata (not required for local-only mode) ---
# DATABASE_URL=
# When unset, cloud library APIs return 503 not_connected.
# FUJARA_SESSION_SECRET=
# Required before any cloud route accepts a bearer token.
# This starter does not ship a full Supabase login UI.

# --- Optional Google Drive backup (separate from Fujara sign-in) ---
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/drive/callback
# Create credentials in Google Cloud Console. See docs/google-drive-setup.md.
# Client secret must stay on the server. Do not prefix it with NEXT_PUBLIC_.

# --- Development only ---
# Set to "true" to show an explicitly labeled mock catalogue. Never enable in production.
# NEXT_PUBLIC_ENABLE_MOCK_SOURCE=false
